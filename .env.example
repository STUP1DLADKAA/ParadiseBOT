# Paradise configuration — copy to .env and fill in.
# Never commit the real .env file.

# Required: Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=

# ── Home guild & operator access ────────────────────────────────────────────
# Home guild: slash commands are published to this guild instantly on every
# boot (new commands appear at once, removed ones vanish). Leave blank to
# register globally instead — Discord can take up to an hour to show those.
DISCORD_GUILD_ID=

# Operator-only features, by Discord user ID (not secrets). Comma-separated.
# /edit        — adjust a member's tracked voice time
# /clip        — record and export the rolling voice clip
# deaf exempt  — members whose voice time still counts while they are deafened
# Leave blank to default to the two lords (see PARADISE_LORD_USER_IDS below);
# set a bogus ID to disable a feature.
EDIT_ALLOWED_USER_IDS=
CLIP_ALLOWED_USER_IDS=
VOICE_DEAF_EXEMPT_USER_IDS=


# ── Performance ─────────────────────────────────────────────────────────────
# Paradise sizes its thread pools and HTTP connection pools to the machine by
# default, and warms fonts + card backdrops at start-up so the first command is
# as fast as the thousandth. Disable the warm-up only on a tiny/exhausted box.
PREWARM_ON_START=true


# The /recipe, /weather, /convert, /time, /settimezone, and /vc commands
# need NO mandatory configuration — they run key-less out of the box, and so
# do web research, link summaries and the free toolkit.
# (Free-form questions use the AI providers below.)

# ---------------------------------------------------------------------------
# Voice Activity Tracking & Daily Reports (/vc leaderboard, /vc stats)
# ---------------------------------------------------------------------------
# IMPORTANT: enable the "Server Members Intent" for your bot in the Discord
# Developer Portal (Bot page). Without it leaderboards cannot resolve
# member names/avatars reliably.
#
# Voice data lives in SUPABASE (the authoritative database). Setup:
#   1. Open the Supabase Dashboard (project "Paradise") → SQL Editor.
#   2. Run the migrations in supabase/migrations/ in order: 001_voice_activity,
#      002_voice_ist_calendar, 003_voice_checkpoint, 004_voice_credit_carry
#      (see supabase/README.md). 004 fixes time shaved off long sessions.
#   3. Fill in SUPABASE_URL and SUPABASE_SECRET_KEY below.
# Without these two values the bot starts fine but voice tracking stays
# disabled (with a clear log message) — nothing else breaks.
#
# SECURITY: SUPABASE_SECRET_KEY is the server-side SECRET key (service_role,
# newer projects prefix it sb_secret_…). It bypasses Row Level Security and
# belongs ONLY in this private .env file: never commit it, never log it,
# never expose it to browsers, clients or Discord users. Do NOT use the
# public/anon key here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# How often active VC sessions heartbeat last_seen_at to Supabase (seconds).
# 15–30 keeps the leaderboard near-real-time without database spam.
VOICE_HEARTBEAT_INTERVAL=20
# Rows per batch for the automatic SQLite → Supabase history migration.
VOICE_MIGRATION_BATCH_SIZE=500
# Seconds between retry cycles for pending migrations / queued writes.
VOICE_FLUSH_INTERVAL=30
# Coalescing window (seconds) for voice activity updates. Mute/deafen/channel
# changes inside one window are merged into a single batched Supabase upsert;
# joins and leaves are still written immediately. This is the maximum delay
# before an in-progress session's last_seen_at reaches the database (the
# periodic heartbeat below still runs). 0 restores one write per event.
VOICE_WRITE_COALESCE_SECONDS=2
# How often an in-progress voice session is committed to voice_daily_stats
# (seconds). Bounds how much voice time a crash can lose and how long a manual
# Supabase correction takes to be adopted. One batched request covers every
# live session. 0 disables periodic checkpointing.
VOICE_CHECKPOINT_SECONDS=120
# Per-request timeout (seconds) for Supabase calls.
VOICE_SUPABASE_TIMEOUT=15
# Local SQLite file — NOT the leaderboard source. It keeps user settings
# (timezones, DM preferences) and acts as a bounded, temporary fallback
# queue only while Supabase is unreachable. Defaults to data/paradise.db
VOICE_DB_PATH=
# Automatically send daily voice summary DMs at the end of each day
VOICE_DM_REPORTS_ENABLED=true
# Channel where 30-second deafen warnings and the 12:00 AM daily VC leaderboard
# are posted. Leave blank (or 0) to disable both.
VOICE_ALERT_CHANNEL_ID=
# Continuous deafened duration (seconds) before sending the ping warning
VOICE_DEAF_WARNING_SECONDS=30

# ---------------------------------------------------------------------------
# Rolling Voice Clip Buffer (/clip duration:<seconds>, owner-authorized DM)
# ---------------------------------------------------------------------------
# Volatile in-memory rolling buffer (up to 180 seconds, auto-evicted).
VOICE_CLIP_ENABLED=true
VOICE_CLIP_MAX_SECONDS=180
VOICE_CLIP_MAX_SPEAKERS=32
# Ceiling on buffered Opus per guild (a ceiling, not an allocation: three
# minutes of a busy channel is a few MB, and it is dropped when recording stops).
VOICE_CLIP_MAX_BUFFER_MB=32
# Exports are short FFmpeg bursts (a 60-second clip encodes in about a second),
# so one at a time plus a two-deep queue never makes anybody wait — and the box
# never runs two encoders at once.
VOICE_CLIP_MAX_CONCURRENT_EXPORTS=1
VOICE_CLIP_MAX_QUEUED_EXPORTS=2
VOICE_CLIP_EXPORT_TIMEOUT=45
VOICE_CLIP_MAX_FILE_BYTES=9961472
VOICE_CLIP_MAX_TEMP_MB=64
# Recording quality. Opus arrives at 48 kHz mono and is re-encoded exactly once;
# 128 kbps AAC-LC is transparent for speech (up to 320 is allowed). A minute of
# audio is ~950 KB.
VOICE_CLIP_BITRATE_KBPS=128
# Optional custom mastering chain for the encoded clip. Blank uses
# "highpass=f=70,lowpass=f=18500,alimiter=limit=0.95:...". No loudness
# normalisation is applied here: the level is set once, statically, in the
# mixer, so a pause stays as quiet relative to speech as it really was.
VOICE_CLIP_AUDIO_FILTER=
# Capture is silent and unconditional: no notice is posted, nobody opts in or
# out, and every human in the channel is included.

# ---------------------------------------------------------------------------
# Automated Paradise mini-games
# ---------------------------------------------------------------------------
# Optional announcement channel override. If blank/0, the bot uses the home
# guild's system channel, then its first sendable text channel.
MINIGAMES_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Dictionary (/dictionary, /define, and "define hello" in chat)
# ---------------------------------------------------------------------------
# Needs NO configuration either. Word data comes from two free, key-less
# sources (api.dictionaryapi.dev and api.datamuse.com) and the 🔊 button
# falls back to a free voice when a word has no human recording.
#
# Everything below is optional.

# Answer plain-chat requests ("define hello", "what does hello mean?").
# Set to false to make the dictionary slash-command-only.
DICTIONARY_TEXT_TRIGGERS=true
# Per-request deadline in seconds for lookups and audio.
DICTIONARY_TIMEOUT=8
# How long a looked-up word stays cached, and how many words to keep.
DICTIONARY_CACHE_TTL=21600
DICTIONARY_CACHE_SIZE=1024
# The rendered Material dictionary card surface: dark (default) or light.
DICTIONARY_CARD_THEME=dark

# Prefer the dictionary's own human recording over a synthesised voice.
PRONUNCIATION_PREFER_NATIVE=true
# Speak the word in the asker's voice channel instead of attaching a file.
# Needs PyNaCl (`pip install "discord.py[voice]"`) and ffmpeg on PATH;
# without either it silently stays off and the audio is attached instead.
PRONUNCIATION_VOICE_PLAYBACK=false

# Optional upgrade: a neural voice for words with no human recording.
# Any OpenAI-compatible /audio/speech endpoint works. Leave blank to use
# the free fallback voice.
#   OpenAI: SPEECH_BASE_URL=https://api.openai.com/v1  SPEECH_MODEL=gpt-4o-mini-tts  SPEECH_VOICE=alloy
SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_MODEL=
SPEECH_VOICE=

# ---------------------------------------------------------------------------
# ElevenLabs — YOUR voice (word pronunciation audio)
# ---------------------------------------------------------------------------
# SECURITY: the key lives ONLY here, travels only in the xi-api-key header and
# is never logged, echoed in a message or committed.
#
# 1. Copy the API key from https://elevenlabs.io/app/settings/api-keys
# 2. Copy the voice ID of your custom/cloned male voice
#    (https://elevenlabs.io/app/voice-lab → the voice → "ID").
# 3. Leave both blank to fall back to the free voices — nothing breaks.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# FASTEST multilingual model: Hindi + English in one voice, lowest latency.
# Alternatives: eleven_turbo_v2_5 (slightly richer) · eleven_multilingual_v2
# (highest quality, slowest).
ELEVENLABS_MODEL=eleven_flash_v2_5
# 44.1 kHz 128 kbps MP3 — clean speech, tiny files.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Voice shaping: lower stability = more expressive, higher similarity = closer
# to the captured voice. Speed 0.7–1.2.
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.85
ELEVENLABS_STYLE=0.15
ELEVENLABS_SPEED=1.0
# Optional fixed language ("hi" or "en"). Blank = auto-detect, which handles
# Hinglish sentences best.
ELEVENLABS_LANGUAGE=
# Use this voice for dictionary words too, even when a human recording exists.
ELEVENLABS_PRONUNCIATION_FIRST=true
ELEVENLABS_TIMEOUT=25

# ---------------------------------------------------------------------------
# Voice-channel presence (Paradise follows the crowd, silently)
# ---------------------------------------------------------------------------
VOICE_PRESENCE_ENABLED=true
# FALSE = silent join: no message in the channel, nothing spoken. This is the
# default. TRUE restores the old random "arrival line" (text + speech).
VOICE_ARRIVAL_ANNOUNCE=false
# Seconds between crowd-following scans (snappier joins with a lower value).
VOICE_PRESENCE_INTERVAL=20
# Where preloaded speech clips are cached. Blank = data/tts_cache.
TTS_CACHE_DIR=

# ---------------------------------------------------------------------------
# Auto-update from GitHub (pull the latest files on start-up and while online)
# ---------------------------------------------------------------------------
# Paradise checks STUP1DLADKAA/ParadiseBOT for a newer commit. When there is
# one it downloads that exact revision, validates it (every .py compiles, the
# tree really is the bot) and copies the files in. The terminal then says:
#     🔄 AUTO-UPDATE APPLIED — 12 file(s) updated → commit abc1234
#     RESTART Paradise to run the new code.
# .env, .git, data/, virtualenvs, caches and *.db/*.log files are NEVER touched.
AUTO_UPDATE_ENABLED=true
AUTO_UPDATE_REPO=STUP1DLADKAA/ParadiseBOT
AUTO_UPDATE_BRANCH=main
# Seconds between checks while the bot is online (0 disables the timer).
AUTO_UPDATE_INTERVAL=1800
# Check once before logging in.
AUTO_UPDATE_ON_START=true
# FALSE = only report that an update exists, never touch a file.
AUTO_UPDATE_APPLY=true
# TRUE = exit after applying a start-up update so the process manager restarts
# cleanly on the new code (recommended: half-old/half-new Python is unsafe).
AUTO_UPDATE_RESTART=true
# Optional GitHub token: raises the API rate limit and is required for private
# repositories. Never logged.
GITHUB_TOKEN=
AUTO_UPDATE_TIMEOUT=45
AUTO_UPDATE_STARTUP_TIMEOUT=20
# Where the applied-commit state file lives. Blank = data/autoupdate_state.json
AUTO_UPDATE_STATE_DIR=
# Extra relative paths to protect from updates (comma separated).
AUTO_UPDATE_PROTECTED=

# ---------------------------------------------------------------------------
# Web image search ("@Paradise show me a picture of a red panda")
# ---------------------------------------------------------------------------
# Needs NO configuration. Paradise SEARCHES THE WEB for real photos — it
# never generates AI images — using three key-less providers in order:
# Wikipedia page images, Wikimedia Commons and Openverse.
#
# Everything below is optional.

# Master switch for picture requests.
IMAGE_SEARCH_ENABLED=true
# Per-request deadline in seconds for outbound image-search calls.
IMAGE_SEARCH_TIMEOUT=10
# How long a found image URL stays cached, and how many to keep. Only short
# URLs are cached — image files are never downloaded or stored.
IMAGE_SEARCH_CACHE_TTL=1800
IMAGE_SEARCH_CACHE_SIZE=128

# Optional upgrade: Google Programmable Search gives much broader coverage
# for non-encyclopedic subjects (games, memes, products). BOTH values are
# required, otherwise the key-less providers are used.
#   1. API key:    https://developers.google.com/custom-search/v1/overview
#   2. Engine ID:  https://programmablesearchengine.google.com/
#                  (create an engine, enable "Image search" + "Search the
#                   entire web", then copy the Search engine ID)
# Free tier: 100 queries/day. SECURITY: this key belongs only in your
# private .env — it is never logged and never shown in bot messages.
IMAGE_SEARCH_API_KEY=
IMAGE_SEARCH_ENGINE_ID=

# ---------------------------------------------------------------------------
# Web research ("@Paradise search …", "latest Minecraft news", link summaries)
# ---------------------------------------------------------------------------
# Needs NO configuration. Paradise searches the real web with two key-less
# sources (DuckDuckGo's lite endpoint and the Wikipedia API), reads the top
# pages, and answers with clickable sources — it never invents a citation.
# If the web side fails or is switched off, the same question goes straight
# to the AI model instead; a genuine question is never refused.
#
# Everything below is optional.

# Master switch for web research. false → search asks get a direct AI answer.
WEB_SEARCH_ENABLED=true
# Per-request deadline in seconds for each outbound search/fetch call.
WEB_SEARCH_TIMEOUT=10
# Search results kept per query (clamped to 3–8).
WEB_SEARCH_MAX_RESULTS=5
# How many of the top results are actually fetched and read (0–3). 0 answers
# from the result snippets alone — faster, less page context.
WEB_SEARCH_FETCH_PAGES=2
# How long a search or fetched page stays cached, and how many to keep.
WEB_SEARCH_CACHE_TTL=900
WEB_SEARCH_CACHE_SIZE=128
# Characters of a fetched page handed to the model (long pages are trimmed
# from the middle of the text, keeping the start).
WEB_SEARCH_PAGE_CHARS=6000
# Append the real source links under every research answer.
WEB_SEARCH_SHOW_SOURCES=true

# ---------------------------------------------------------------------------
# AI providers (optional) — the personality behind the bot's chat
# ---------------------------------------------------------------------------
# Provider priority: the OpenAI-compatible endpoint below is ALWAYS asked
# first; Gemini answers only when that endpoint is not configured or is
# temporarily failing. Search-shaped requests ("@Paradise search …") go
# through web research first (see above) and fall back to the AI when the
# web side is off; free-form questions are answered by the AI directly, in
# the ParadiseBOT personality. Genuine questions are never refused.
#
# Everything else on this bot works WITHOUT any key: dictionary, conversions,
# calculator, weather, time, translation and image search are tool-first and
# never need AI. With no key at all the bot runs fully; with a bad key it
# logs a warning and keeps working without AI.
#
# SECURITY: keys belong ONLY here in your private .env (never committed).
# They are never shown in bot messages and never logged in full.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# More models on the SAME endpoint, each tagged with the job it's best at:
# "fast" models answer labels, quips and anything latency-sensitive; "deep"
# models answer real questions, recaps and roasts. Any provider on the list
# can fail and the next one takes over mid-flight — then Gemini, as always.
# Entries are "role:model", comma separated; a bare model name does both jobs.
#   AI_MODELS=fast:gpt-4o-mini,deep:gpt-4o
# Unset (default) → the single AI_MODEL above does everything.
AI_MODELS=
#
# The fallback provider — Google Gemini (get a key at
# https://aistudio.google.com/apikey). Used whenever the primary endpoint
# above is missing or unavailable.
#   OpenAI:  AI_BASE_URL=https://api.openai.com/v1       AI_MODEL=gpt-4o-mini
#   Groq:    AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
#   Ollama:  AI_BASE_URL=http://localhost:11434/v1       AI_MODEL=llama3.1   (key can stay empty)
GEMINI_API_KEY=
# Which Gemini model to use (configurable — nothing hard-codes a model).
GEMINI_MODEL=gemini-2.5-flash
# Master switch without deleting the key.
GEMINI_ENABLED=true
# Check the key against the API at startup (never fatal if it can't).
GEMINI_VALIDATE_ON_START=true
# Per-request deadline in seconds for Gemini calls.
GEMINI_TIMEOUT=30

# ---------------------------------------------------------------------------
# Personality — how alive, how loud, how mean
# ---------------------------------------------------------------------------
# This is the bot's whole social life: reactions, replies, stickers, memes from
# the internet, reaction GIFs, spontaneous quips, roasts, and English-only nerd
# grammar corrections. The defaults below are tuned for a small friends-only
# server where Paradise is meant to be one of the loudest people in the room.
# Turn any single number down, or set PERSONALITY_ENABLED=false for silence.
PERSONALITY_ENABLED=true
# Chance to react to a message that matches a known context.
PERSONALITY_REACTION_CHANCE=0.18
# Chance to react to a message that matches nothing at all (pure presence).
PERSONALITY_AMBIENT_REACTION_CHANCE=0.06
# Chance to send a short contextual reply instead of a reaction.
PERSONALITY_REPLY_CHANCE=0.08
# Chance to answer with a sticker.
PERSONALITY_STICKER_CHANCE=0.04
# Chance to answer with a meme.
PERSONALITY_MEME_CHANCE=0.10
# Of those memes, how many come from the internet (the rest are drawn locally).
PERSONALITY_ONLINE_MEME_CHANCE=0.75
# Chance to answer with a reaction GIF. Works keyless out of the box; a
# TENOR_API_KEY or GIPHY_API_KEY below makes the results better.
PERSONALITY_GIF_CHANCE=0.06
# Chance to drop an unprompted 200-IQ / 2-IQ observation.
PERSONALITY_QUIP_CHANCE=0.08
# Chance to roast whoever just spoke. "roast me" and "1v1 me" always get an
# answer, regardless of this number.
PERSONALITY_ROAST_CHANCE=0.08
# How mean: mild (friendly teasing), spicy (default), nuclear (unfiltered).
# Roasts are always about what someone said or did — never about who they are —
# and they stop completely on any message that reads like real distress.
PERSONALITY_ROAST_INTENSITY=spicy
# Seconds before the same person can be roasted again. Nobody gets farmed.
PERSONALITY_ROAST_USER_COOLDOWN=600
# Chance to correct an English typo/grammar slip in nerd voice.
PERSONALITY_GRAMMAR_CHANCE=0.70
# Seconds between ANY two personality actions, bot-wide.
PERSONALITY_GLOBAL_COOLDOWN=10
# Seconds between personality actions in the same channel.
PERSONALITY_CHANNEL_COOLDOWN=60
# Extra spacing for contextual replies in the same channel.
PERSONALITY_REPLY_CHANNEL_COOLDOWN=180
# Per-channel spacing for stickers, memes, GIFs and spontaneous quips.
PERSONALITY_HUMOUR_COOLDOWN=45
# Per-channel spacing for English grammar/spelling corrections.
PERSONALITY_GRAMMAR_COOLDOWN=90
# Chance to drop a "hello!"-style line when two people are talking.
PERSONALITY_INTERJECT_CHANCE=0.04
# Seconds before Paradise interjects in the same channel again.
PERSONALITY_INTERJECT_COOLDOWN=600
# Chance to acknowledge the lord (a "my lord 👑" line or a crown reaction)
# when he himself speaks.
PERSONALITY_LORD_REPLY_CHANCE=0.20
# Chance to quote one known fact back at the person it's about, when somebody
# the bot has /memory facts on speaks. No AI call — just a quote and a frame,
# and never framed as remembering: the bot knew already, it stalks the server.
# Rare on purpose: the joke is the timing.
PERSONALITY_MEMORY_CALLBACK_CHANCE=0.05
# Seconds before the same person gets a memory callback again.
PERSONALITY_MEMORY_CALLBACK_COOLDOWN=1800
# Hard ceiling on UNPROMPTED chatter per channel per rolling hour (replies to
# mentions, invited roasts and grammar bait never count). 0 = no ceiling.
# Paradise stays alive — it just stops narrating the whole evening.
PERSONALITY_AMBIENT_HOURLY_CAP=6

# Memes come from Reddit through meme-api.com, which needs NO key. Pick the
# communities, comma separated; they are tried in a random order.
MEME_SOURCES=dankmemes,memes,me_irl,wholesomememes,terriblefacebookmemes,historymemes
# Per-request deadline (seconds) for the meme and GIF APIs.
MEME_TIMEOUT=6

# Reaction GIFs (optional). GIFs already work WITHOUT any key through Tenor's
# legacy public endpoint; setting a key here makes results better and faster.
#   Tenor: https://developers.google.com/tenor/guides/quickstart
#   Giphy: https://developers.giphy.com/dashboard/
# SECURITY: these keys live only in this private .env — never logged, never
# shown in a message.
TENOR_API_KEY=
GIPHY_API_KEY=

# ---------------------------------------------------------------------------
# The lords and memory
# ---------------------------------------------------------------------------
# The lords and masters — Stupid (the owner) and Taher, at the same level of
# authority, masters of everyone: always addressed as "my lord", always
# teased, and the only users allowed to run /memory (plus the operator
# features /edit, /clip and the deafen exemption below).
PARADISE_LORD_USER_IDS=922359954025885737,1049231767585964032
# Legacy single-lord form (still honoured, merged into the list above).
PARADISE_LORD_USER_ID=

# Long-term memory (/memory). A tiny SQLite database of the lord's facts that
# the AI folds into its answers. MEMORY_MAX_ENTRIES caps it (oldest dropped).
# Memories are ABOUT specific members and surface at the right moment: in the
# AI's answers when that person talks, and (rarely) as a personality callback.
MEMORY_DB_PATH=data/memory.db
MEMORY_MAX_ENTRIES=200
# Optional Supabase mirror: when SUPABASE_URL + SUPABASE_SECRET_KEY are set
# (the same values as voice tracking), memories are also synced to the
# paradise_memories table — run supabase/migrations/005_memory.sql first.
# The local SQLite file stays the working store; Supabase is the durable copy.
# How often the mirror reconciles (seconds).
MEMORY_SUPABASE_INTERVAL_SECONDS=120
# Per-request deadline (seconds) for the memory mirror's Supabase calls.
MEMORY_SUPABASE_TIMEOUT=10
