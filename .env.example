# Paradise configuration — copy to .env and fill in.
# Never commit the real .env file.

# Required: Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=

# Lavalink node — music and voice TTS need one.
# Any Lavalink v4 node works; get credentials from your node host.
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
# Rough region of the node: in / eu / us / sg …
LAVALINK_REGION=in
# Plugins the node is expected to have loaded ("name" or "name:version",
# comma separated). Purely diagnostic — Paradise checks /v4/info on connect,
# logs anything missing and shows it in /status. Music itself works with
# whatever sources the node reports.
# Example: youtube-plugin:f45bbb7aebfcbc1c553769e04af6cd43afa8b7c3,chanom-plugin:1.0.6
LAVALINK_EXPECTED_PLUGINS=

# AI (optional) — any OpenAI-compatible chat completions endpoint.
# Examples:
#   OpenAI:  AI_BASE_URL=https://api.openai.com/v1       AI_MODEL=gpt-4o-mini
#   Groq:    AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
#   Ollama:  AI_BASE_URL=http://localhost:11434/v1       AI_MODEL=llama3.1   (key can stay empty)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Text-to-speech (optional, free neural voices via edge-tts).
TTS_ENABLED=true
TTS_VOICE_HI=hi-IN-MadhurNeural
TTS_VOICE_EN=en-IN-PrabhatNeural
TTS_MAX_LENGTH=220
TTS_USER_COOLDOWN=30
TTS_GLOBAL_COOLDOWN=8

# Music behaviour
MUSIC_MAX_VOLUME=150
MUSIC_MAX_HISTORY=50
AUTO_DISCONNECT_MINUTES=10

# Lyrics for the current track. Free providers (LRCLIB, lyrics.ovh) need no key;
# set false to hide /lyrics entirely.
LYRICS_ENABLED=true
# Optional third lyrics provider (https://genius.com/api-clients). Leave blank
# to skip it — Paradise never requires this key.
GENIUS_API_KEY=
